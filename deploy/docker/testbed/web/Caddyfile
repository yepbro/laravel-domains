(chain_redirect-chain) {
    redir / /r1 307
    redir /r1 /r2 307
    redir /r2 /r3 307
    redir /r3 /final.html 307
    root * /srv/sites/redirect-chain
    file_server
}

http://redirect-chain.crawl.test {
    import chain_redirect-chain
}

https://redirect-chain.crawl.test {
    tls internal
    import chain_redirect-chain
}

