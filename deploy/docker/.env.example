# ============================================================================
# Domain Crawler — environment variables of the dev infrastructure.
# Copy to .env at the repository root:  cp .env.example .env
# The .env itself does not get into git (.gitignore).
# ============================================================================

# --- Base image and tool versions (pinned, not latest) --------
GO_VERSION=1.26.9
ALPINE_VERSION=3.24.2
POSTGRES_IMAGE=postgres:16.15-alpine3.24
REDIS_IMAGE=redis:7.4.11-alpine3.21
COREDNS_IMAGE=coredns/coredns:1.14.7
CADDY_IMAGE=caddy:2.11.7-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
ADMINER_IMAGE=adminer:5.5.1-standalone
REDIS_INSIGHT_IMAGE=redis/redisinsight:3.2.0
CHROMEDP_HEADLESS_IMAGE=chromedp/headless-shell:156.0.8078.17

# --- Alternative render engines (the render-engines profile, stage 35) -------
# FR-17: an engine version change is a separate procedure with a bench smoke
# run, not "drifted with latest". Lightpanda — the official image (change
# LIGHTPANDA_IMAGE: dc pull lightpanda && dc --profile render-engines up -d lightpanda);
# Moli — built from the release tarball (deploy/docker/Dockerfile.moli): the
# version and the asset checksum (digest from the GitHub release page) change
# as a pair; the image is tagged with the version — compose builds the new tag itself.
LIGHTPANDA_IMAGE=lightpanda/browser:1.0.2
MOLI_VERSION=v1.1.21
MOLI_SHA256=048d9e482b6c618af08b17eb19200ea65b1b2fafd39975e5b9de19a60653ed8f
# The moli image base (glibc: the release binaries are linux-gnu, alpine does
# not fit; BuildKit picks the architecture itself — amd64/arm64).
DEBIAN_VERSION=13.7-slim

# --- Tools of the Go image (dev stage) ---------------------------------------
AIR_VERSION=v1.67.4
DELVE_VERSION=v1.27.2
GOLANGCI_LINT_VERSION=v2.14.0
MIGRATE_VERSION=v4.20.1
# Mutation testing (make mutate): the maintained fork
# avito-tech/go-mutesting of the zimmski/go-mutesting tool — the upstream
# died in 2021 and panics on go/types under modern toolchains.
# The version below is the last one for go ≤ 1.26 (the fork's go.mod: go 1.25.5).
GO_MUTESTING_VERSION=v0.0.0-20251226130216-48d0401f00fb

# The Tailwind v4 standalone CLI — the landing bundle (the css stage of
# Dockerfile.go and make web-css, T-124); node appears neither in the build
# nor at runtime.
TAILWINDCSS_VERSION=v4.3.3

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_ADMIN_USER=admin
POSTGRES_PASSWORD=dev-only-admin
POSTGRES_DB=crawler
APP_DB_USER=crawler
APP_DB_PASSWORD=dev-only-crawler
# The DB port on the host (127.0.0.1 only)
PG_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- Bind-mount permissions (the developer's UID/GID; see id -u / id -g) -----
DEV_UID=1001
DEV_GID=1001

# --- Memory limits (can be reduced on weak machines) -------------------------
MEM_POSTGRES=1536m
MEM_REDIS=256m
# The spec 3.2 budget (Unbound ≈ 0.7 GB). Internet mode (make up-internet)
# allocates caches ≈ 542 MB — do not go below ~650m; testbed mode is fine with 256m.
MEM_UNBOUND=700m
# The Chromium budget of spec 3.2 (≈ 2 GB): the dev chromium service and the
# production render container (the runtime profile). The in-worker restart
# threshold by RSS — 1.5 GiB (render.restart_memory_bytes), below this limit.
MEM_CHROMIUM=2048m
MEM_RENDER=2048m
# Starting budgets of the alternative render engines (the render-engines
# profile): starting at ≤1 GB each (the render-engines spec §4.7 item 2);
# adjusted per the bench comparison measurements (§5.1 of that spec).
MEM_LIGHTPANDA=1gb
MEM_MOLI=1gb

# --- Internet access ---------------------------------------------------------
# 0 — testbed mode: outbound DNS queries are blocked (the default).
# 1 — allows enabling real recursion via `make up-internet`.
#     WARNING: the crawler gets access to real sites. Enable deliberately.
ALLOW_INTERNET=0

# The unbound mode: testbed (everything is forwarded to coredns, the rest REFUSED)
# or internet (real recursion). Changed only via make up-internet.
UNBOUND_MODE=testbed
UNBOUND_HEALTH_NAME=same-site.crawl.test

# --- Service ports on the host (127.0.0.1) -----------------------------------
PROMETHEUS_PORT=9090
ADMINER_PORT=8080
REDIS_INSIGHT_PORT=5540
TESTWEB_HTTP_PORT=8088
TESTWEB_HTTPS_PORT=8443
# The landing (web, the app profile) — a public service; in dev it is published
# on the host loopback. 8081, because 8080 is taken by Adminer.
WEB_PORT=8081
# The operator dashboard (dashboard, the app profile) — an internal service
# with password access; in dev it is also published only on the host loopback
# (the dev credentials admin/admin — config.dev.yaml, docs/dev-environment.md).
DASHBOARD_PORT=8090

# --- The crawler User-Agent in dev mode (the dev marker is mandatory) --------
CRAWLER_USER_AGENT=DomainCrawler/dev (+dev-environment; contact: dev@example.invalid)
