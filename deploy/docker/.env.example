# ============================================================================
# Domain Crawler — переменные окружения dev-инфраструктуры.
# Скопируйте в .env в корне репозитория:  cp .env.example .env
# Сам .env в git не попадает (.gitignore).
# ============================================================================

# --- Версии базовых образов и инструментов (фиксируются, не latest) --------
GO_VERSION=1.26.9
ALPINE_VERSION=3.24.2
POSTGRES_IMAGE=postgres:16.15-alpine3.24
REDIS_IMAGE=redis:7.4.11-alpine3.21
COREDNS_IMAGE=coredns/coredns:1.14.7
CADDY_IMAGE=caddy:2.11.7-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
ADMINER_IMAGE=adminer:5.5.1-standalone
REDIS_INSIGHT_IMAGE=redis/redisinsight:3.2.0
CHROMEDP_HEADLESS_IMAGE=chromedp/headless-shell:156.0.8078.17

# --- Инструменты Go-образа (dev stage) --------------------------------------
AIR_VERSION=v1.67.4
DELVE_VERSION=v1.27.2
GOLANGCI_LINT_VERSION=v2.14.0
MIGRATE_VERSION=v4.20.1

# Standalone-CLI Tailwind v4 — бандл лендинга (стадия css Dockerfile.go и
# make web-css, T-124); node не появляется ни в сборке, ни в рантайме.
TAILWINDCSS_VERSION=v4.3.3

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_ADMIN_USER=admin
POSTGRES_PASSWORD=dev-only-admin
POSTGRES_DB=crawler
APP_DB_USER=crawler
APP_DB_PASSWORD=dev-only-crawler
# Порт БД на хосте (только 127.0.0.1)
PG_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- Права на bind-mount (UID/GID разработчика; см. id -u / id -g) ----------
DEV_UID=1001
DEV_GID=1001

# --- Лимиты памяти (для слабых машин можно уменьшить) -----------------------
MEM_POSTGRES=1536m
MEM_REDIS=256m
# Бюджет ТЗ 3.2 (Unbound ≈ 0,7 ГБ). Режим internet (make up-internet) аллоцирует
# кэши ≈ 542 МБ — ниже ~650m не опускать; режиму testbed хватает и 256m.
MEM_UNBOUND=700m
# Бюджет Chromium ТЗ 3.2 (≈ 2 ГБ): dev-сервис chromium и боевой render-контейнер
# (профиль runtime). Порог перезапуска по RSS внутри воркера — 1,5 ГиБ
# (render.restart_memory_bytes), ниже этого лимита.
MEM_CHROMIUM=2048m
MEM_RENDER=2048m

# --- Выход в интернет --------------------------------------------------------
# 0 — режим testbed: DNS-запросы наружу блокируются (по умолчанию).
# 1 — разрешает включить реальную рекурсию через `make up-internet`.
#     ВНИМАНИЕ: краулер получает доступ к реальным сайтам. Включайте осознанно.
ALLOW_INTERNET=0

# Режим unbound: testbed (всё в forward на coredns, остальное REFUSED)
# или internet (реальная рекурсия). Меняется только через make up-internet.
UNBOUND_MODE=testbed
UNBOUND_HEALTH_NAME=same-site.crawl.test

# --- Сервисные порты на хосте (127.0.0.1) ------------------------------------
PROMETHEUS_PORT=9090
ADMINER_PORT=8080
REDIS_INSIGHT_PORT=5540
TESTWEB_HTTP_PORT=8088
TESTWEB_HTTPS_PORT=8443
# Лендинг (web, профиль app) — единственный «публичный» сервис; в dev
# публикуется на loopback хоста. 8081, потому что 8080 занят Adminer.
WEB_PORT=8081

# --- User-Agent краулера в dev-режиме (пометка dev обязательна) --------------
CRAWLER_USER_AGENT=DomainCrawler/dev (+dev-environment; contact: dev@example.invalid)
