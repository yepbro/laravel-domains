# The render image: headless-Chromium + the render-worker binary (spec 4.3).
# render-worker starts Chromium itself (chromedp), hence one process
# per container; shm_size/init/mem_limit are set at run time.
#
# The user is nobody: a dedicated unprivileged user for rendering untrusted
# pages (spec §9, §10.1). The container memory limit — the Chromium budget
# ≈ 2 GB (spec 3.2): the runtime compose profile
# (deploy/docker/compose.yaml, the render service, mem_limit — the docker
# analog of the cgroup MemoryMax from spec 10.1); systemd units with MemoryMax
# — stage 9. Chromium restarts by pages/memory are performed by the worker
# (T-065, render.restart_every_pages / render.restart_memory_bytes).
#
# Verification build: make build-runtime

# syntax=docker/dockerfile:1

ARG GO_VERSION=1.26.9
ARG CHROMEDP_HEADLESS_IMAGE=chromedp/headless-shell:156.0.8078.17

FROM golang:${GO_VERSION}-alpine AS build
ENV GOFLAGS=-mod=readonly \
    GOMODCACHE=/gomod \
    GOCACHE=/gocache \
    CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# Version/revision for crawler_build_info (T-111) — as in Dockerfile.go:
# passed as build args by the caller (.git is outside the build context);
# without the args — unknown. The ARG is declared at the first use (COPY . .),
# after the cacheable go mod download layer.
ARG BUILD_VERSION=unknown
ARG BUILD_REVISION=unknown
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X crawler/internal/metrics.buildMode=prod -X crawler/internal/metrics.buildVersion=${BUILD_VERSION} -X crawler/internal/metrics.buildRevision=${BUILD_REVISION}" -o /out/render-worker ./cmd/render-worker

FROM ${CHROMEDP_HEADLESS_IMAGE} AS render
COPY --from=build /out/render-worker /usr/local/bin/render-worker
ENV HOME=/tmp
# headless-shell lives in /headless-shell; render-worker starts it itself
# (the --no-sandbox flag is passed by the worker code when running in a container).
USER nobody
ENTRYPOINT ["/usr/local/bin/render-worker"]
