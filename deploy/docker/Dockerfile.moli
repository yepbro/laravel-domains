# Минимальный образ Moli (github.com/lexmount/moli, Apache-2.0/MIT) —
# альтернативный движок рендера для dev-стека (этап 35, T-241; ТЗ
# рендер-движков §4.7, ФТ-16). Официального docker-образа нет: бинарь
# берём из tarball релиза (сборка x86_64-unknown-linux-gnu, glibc — alpine
# не подходит) и кладём на debian-slim. Версии пинятся build-args из .env
# (ФТ-17): смена версии движка — отдельная процедура со smoke-прогоном,
# не «поехало с latest». Образ тегируется версией (crawler/moli:
# ${MOLI_VERSION} в compose): смена MOLI_VERSION/MOLI_SHA256 в .env даёт
# новый тег — compose собирает его сам, старый запуск не «залипает».
#
# Запуск (CMD): serve --host 0.0.0.0 --port 9222 (дефолт хоста у serve —
# 127.0.0.1; 0.0.0.0 — универсальный дефолт для docker run) — без --layout
# (реальная геометрия DOM-first краулеру не нужна) и без --resource
# (опциональные ресурсные семейства не включаются: картинки и шрифты
# блокирует этап рендера, T-062); --obey-robots не передаётся (ФТ-18).
# --block-private-networks (второй слой SSRF, ФТ-18) тоже не включаем:
# в testbed страницы отдаёт testweb 172.28.100.12 — приватный адрес;
# SSRF-контур держит воркер (T-219/T-230), а не движок.
# В compose-сервисе хост бинда переопределяется на статический адрес
# 172.28.100.17: Moli строит webSocketDebuggerUrl из адреса бинда, и при
# 0.0.0.0 remote-воркер получал бы нерабочий ws://0.0.0.0:9222 (см.
# комментарий у сервиса moli в compose.yaml).
#
# Сборка: dc --profile render-engines up -d moli (или dc build moli).

# syntax=docker/dockerfile:1

ARG DEBIAN_VERSION=13.7-slim
ARG MOLI_VERSION=v1.1.21
ARG MOLI_SHA256=048d9e482b6c618af08b17eb19200ea65b1b2fafd39975e5b9de19a60653ed8f

FROM debian:${DEBIAN_VERSION}
ARG MOLI_VERSION
ARG MOLI_SHA256
# Релизный бинарь динамически линкуется (проверено ldd): libstdc++/libgcc
# и стек шрифтов libfontconfig/libfreetype (+их зависимости: libpng, brotli,
# expat, bz2) — в debian-slim их нет, ставим минимальный набор явно.
# curl — скачивание tarball и healthcheck /json/version (по образцу стадии
# mockserver в Dockerfile.go); ca-certificates — TLS-верификация рендеримых
# страниц.
RUN apt-get update -yq \
 && apt-get install -yq --no-install-recommends ca-certificates curl \
    libstdc++6 libfontconfig1 libfreetype6 \
 && rm -rf /var/lib/apt/lists/*
# Tarball качаем и распаковываем одним RUN: удаление в отдельном слое не
# уменьшает образ, а отдельный ADD с URL оставил бы 45 МБ мёртвым слоем.
# Контрольная сумма релизного ассета (digest со страницы релиза GitHub;
# формат sha256sum -c — ровно два пробела) — защита от подмены/битой
# выгрузки; MOLI_VERSION и MOLI_SHA256 в .env меняются парой. Целевая
# архитектура — по TARGETARCH BuildKit (amd64/arm64), релизные ассеты есть
# для обеих. Tarball содержит каталог верхнего уровня с бинарём —
# --strip-components=1 (как в официальном moli-installer.sh).
ARG TARGETARCH
RUN set -eu \
 && case "${TARGETARCH}" in \
      arm64) moli_target=aarch64-unknown-linux-gnu ;; \
      *) moli_target=x86_64-unknown-linux-gnu ;; \
    esac \
 && curl -fsSLo /tmp/moli.tar.gz \
      "https://github.com/lexmount/moli/releases/download/${MOLI_VERSION}/moli-${moli_target}.tar.gz" \
 && echo "${MOLI_SHA256}  /tmp/moli.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/moli.tar.gz -C /tmp --strip-components=1 \
 && install -m 0755 /tmp/moli /usr/local/bin/moli \
 && moli --version \
 && rm -rf /tmp/moli.tar.gz /tmp/moli
# Рендер недоверенных страниц без root (ТЗ §9); временные файлы профиля
# (IndexedDB/OPFS без --profile-dir) пишутся в /tmp (1777).
USER nobody
EXPOSE 9222/tcp
ENTRYPOINT ["/usr/local/bin/moli"]
CMD ["serve", "--host", "0.0.0.0", "--port", "9222"]
