# /etc/crawler/crawler.env — EnvironmentFile всех Go-сервисов (deploy/systemd/
# *.service, docs/deploy.md). Установка: cp deploy/systemd/crawler.env.example
# /etc/crawler/crawler.env && chmod 0640 && chown root:crawler.
#
# Это ТОЛЬКО точка входа окружения: структура конфигурации — один YAML
# (CRAWLER_CONFIG → /etc/crawler/config.yaml из config.example.yaml,
# приоритет env > YAML > дефолты — docs/configuration.md). Секрет (DSN)
# держим здесь, а не в YAML: файл 0640 root:crawler, в git не попадает.
# Значения ниже — образец, замените на боевые.

# Единый YAML конфигурации (обязателен).
CRAWLER_CONFIG=/etc/crawler/config.yaml

# PostgreSQL: роль/БД создаёт установка (docs/deploy.md), sslmode=disable —
# loopback одного сервера (ТЗ 3.1).
CRAWLER_POSTGRES_DSN=postgres://crawler:CHANGE_ME@127.0.0.1:5432/crawler?sslmode=disable

# Пул соединений PostgreSQL НА ОДИН сервис: бюджет ТЗ 20–50 — суммарный на
# все (8 сервисов × 5 + dashboard 2 из его юнита + crawlerctl 2 + админ
# ≈ 44–46 при max_connections=50). Эта переменная, будучи включена,
# переопределит и пул дашборда (EnvironmentFile важнее Environment юнита):
# безопасный глобальный максимум — 4 (9 × 4 + 2 + админ ≈ 40).
# Значение примера config.yaml уже укладывается; раскомментируйте, чтобы
# задать всем сервисам сразу (переменная важнее YAML — docs/configuration.md).
#CRAWLER_POSTGRES_POOL_SIZE=4

# Redis и локальный резолвер (ТЗ 5.4: только локальный unbound;
# fallback-резолверы — dns.fallback_resolvers в конфиге).
CRAWLER_REDIS_ADDR=127.0.0.1:6379
CRAWLER_DNS_RESOLVERS=127.0.0.1:53

# Внешний Chromium — юнит crawler-chromium (CDP loopback; docs/deploy.md:
# почему браузер отдельным юнитом, а не процессом воркера).
CRAWLER_RENDER_REMOTE_URL=ws://127.0.0.1:9222

# User-Agent краулера (ТЗ §9: честный, с реальными контактами оператора —
# обязателен к замене; в dev он помечен dev-пометкой, здесь боевой).
CRAWLER_HTTP_USER_AGENT=DomainCrawler/1.0 (+https://crawler.example.com/contact; admin@example.com)

# Доставка алертов monitor в Telegram (T-162, ТЗ 5.9/10.4; monitor.alerts.
# telegram в конфиге): тот же бот и выделенная группа, что у извещений
# CI/CD (docs/ci-cd.md). Токен — @BotFather, id группы — числовой
# идентификатор чата, в который добавлен бот (getUpdates после первого
# сообщения). Обязательны оба: нет любого — monitor пропускает отправку
# (алерты остаются Warn в journald, как шаг CI молчит без секретов).
# Скрипт отправки тоже берёт их из окружения и не печатает: токен не
# попадает в логи и сообщения.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Прокси доставки Telegram (если боевой IP не проходит к
# api.telegram.org — блокировка РКН; curl скрипта telegram-notify.sh
# подхватывает автоматически). HTTP-прокси на внешнем VPS: только
# CONNECT 443, Allow только IP этого сервера — установка и откат:
# docs/operations.md §4.3 п.3 и §5 (запись 24.10). Закомментировано —
# раскомментируйте при такой раскладке сети.
#https_proxy=http://104.253.1.37:3128
