# Domain Crawler — render-worker: rendering SPA in Chromium, DOM into the
# store (spec 5.6). The browser is the external crawler-chromium unit
# (CDP ws://127.0.0.1:9222, render.remote_url): the Chromium ≈ 2 GB budget
# line is separate in spec 3.2, so in the native deploy Chromium lives in
# its own cgroup and the worker runs in remote mode (the same contract as
# the dev app profile, deploy/docker/compose.yaml). While the browser is
# unavailable — a consumption pause (deliveries stay in the stream), a
# browser crash does not take the worker down. Restarting Chromium per
# pages/memory from inside the worker (T-065) is impossible in remote mode
# (a foreign process) — the cap is held by the crawler-chromium unit's
# MemoryMax + its Restart=on-failure (an analogy of the mem_limit of the
# dev chromium service, docs/render.md).

[Unit]
Description=Domain Crawler — render-worker (rendering in Chromium)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target crawler-chromium.service postgresql.service redis-server.service unbound.service
Wants=network-online.target crawler-chromium.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-render-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9105
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-render-worker
ExecStart=/opt/crawler/bin/render-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=256M
# 256M (T-169, was 128M): DOM in flight ≤ render.contexts ×
# content.max_store_bytes (8 × 2 MiB + transient serialization copies) and
# the pgx/queue buffers — the T-092 §6 measurement pressed against the
# 128 MiB cap (23/116/128) already at 4 contexts; by Oct 23 — 117–128 MB +
# swap (a slot-time deficit, in the style of T-160); 8 contexts (T-169)
# double the DOM window. Post-deploy check: memory.events oom=0, NRestarts
# 0 (the budget — docs/deploy.md §2).
# CPU priority (T-158): a pipeline stage, but not the narrow spot; weight
# 300 — between the critical path (1000) and the supporting services (50).
# The render's heavy CPU lives in chromium — a separate cgroup at the
# default 100 (the §12 measurement: chromium 140%): the weights of 1000 at
# http/dns already lower its relative priority tenfold; the priority of the
# pair is set by this worker.
CPUWeight=300
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# It replaces HTML with DOM in the content store shared with http-worker.
ReadWritePaths=/var/lib/crawler/content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
