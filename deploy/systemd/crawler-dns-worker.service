# Domain Crawler — dns-worker: DNS-проверка апекса и субдоменов (ТЗ 5.4).
# MemoryMax — строка бюджета «Go-сервисы ≈ 1,3 ГБ» (ТЗ 3.2), раскладка —
# docs/deploy.md §2 (сумма потолков девяти юнитов — 2308M): dns-worker
# единственный из «лёгких» держит пул UDP-сокетов (dns.udp_pool_size
# 2000) + буферы обменов + TTL-кэш резолвов. Потолок поднят 256M → 384M
# по замеру §12 (T-160): на ≈47 млн доменов воркер периодически упирался
# в 256 MiB (в §6 на смеси ru/rf/su max был 141 MiB), запас — из
# MemAvailable 2.6 GiB.

[Unit]
Description=Domain Crawler — dns-worker (DNS-проверка)
PartOf=crawler.target
# Комментарий о After/Wants без Requires — crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-dns-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9103
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-dns-worker
ExecStart=/opt/crawler/bin/dns-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=384M
# CPU-приоритет (T-158): критический путь конвейера — питает q:http
# (в замере §12 при PSI some 91–95% проверка получала ~90% одного ядра
# против postgres 177% + chromium 140% + analyzer 66%). Вес 1000 как у
# http-worker: DNS-этап не должен отставать от HTTP, иначе конвейер
# душится сверху (backpressure q:http, load-measurements §3).
CPUWeight=1000
# 2000 сокетов пула UDP + TTL-кэш резолвера: nofile как в dev-окружении
# (deploy/docker/compose.yaml), sysctl-потолки — T-088.
LimitNOFILE=65535
UMask=0007
# --- Изоляция (ТЗ §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
