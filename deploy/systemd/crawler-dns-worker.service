# Domain Crawler — dns-worker: the DNS check of the apex and subdomains
# (spec 5.4). MemoryMax — the "Go services ≈ 1.3 GB" budget line (spec 3.2);
# breakdown — docs/deploy.md §2 (the sum of the nine units' caps is 2308M):
# of the "light" services dns-worker is the only one holding a pool of UDP
# sockets (dns.udp_pool_size 2000) + exchange buffers + a TTL cache of
# resolutions. The cap was raised 256M → 384M per the §12 measurement
# (T-160): on ≈47M domains the worker periodically pressed against 256 MiB
# (in §6 on a ru/rf/su mix the max was 141 MiB); the headroom comes from
# MemAvailable 2.6 GiB.

[Unit]
Description=Domain Crawler — dns-worker (DNS check)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-dns-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9103
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-dns-worker
ExecStart=/opt/crawler/bin/dns-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=384M
# CPU priority (T-158): a critical path of the pipeline — it feeds q:http
# (in the §12 measurement, at PSI some 91–95%, the check got ~90% of one
# core vs postgres 177% + chromium 140% + analyzer 66%). Weight 1000, like
# http-worker: the DNS stage must not lag behind HTTP, otherwise the
# pipeline is throttled from above (backpressure of q:http,
# load-measurements §3).
CPUWeight=1000
# 2000 UDP pool sockets + the resolver's TTL cache: nofile as in the dev
# environment (deploy/docker/compose.yaml); the sysctl caps — T-088.
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
