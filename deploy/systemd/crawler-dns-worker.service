# Domain Crawler — dns-worker: DNS-проверка апекса и субдоменов (ТЗ 5.4).
# MemoryMax — строка бюджета «Go-сервисы ≈ 1,3 ГБ» (ТЗ 3.2), раскладка —
# docs/deploy.md: dns-worker единственный из «лёгких» держит пул UDP-сокетов
# (dns.udp_pool_size 2000) и буферы обменов.

[Unit]
Description=Domain Crawler — dns-worker (DNS-проверка)
PartOf=crawler.target
# Комментарий о After/Wants без Requires — crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-dns-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9103
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-dns-worker
ExecStart=/opt/crawler/bin/dns-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=256M
# 2000 сокетов пула UDP + TTL-кэш резолвера: nofile как в dev-окружении
# (deploy/docker/compose.yaml), sysctl-потолки — T-088.
LimitNOFILE=65535
UMask=0007
# --- Изоляция (ТЗ §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
