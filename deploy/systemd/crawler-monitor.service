# Domain Crawler — monitor: zone progress, metrics, alerts (spec 5.9).
# MemoryMax — the "Go services ≈ 1.3 GB" budget line (spec 3.2); breakdown
# in docs/deploy.md. The HTTP endpoint address is set by monitor.listen in
# the config (it beats METRICS_ADDR — docs/services.md); the Environment
# below is the loopback guard (an environment variable beats YAML —
# docs/configuration.md), even if config.yaml is copied from the example
# unedited: metrics are not exposed on external interfaces (spec §9), like
# in the other services (METRICS_ADDR=127.0.0.1:9101…9108 in their units).
# /dev/nvme* (SMART, spec 10.3) is granted to the nvme-smart group (the
# udev rule and drop-in — deploy/smartd/, T-089): without it the wear alert
# honestly reports "not measured".
# The Telegram alert delivery (T-162) reads TELEGRAM_BOT_TOKEN/
# TELEGRAM_CHAT_ID from the EnvironmentFile below (monitor execs
# /opt/crawler/bin/telegram-notify.sh — docs/operations.md §4.3); without
# the secrets delivery is disabled, alerts stay Warn in journald.

[Unit]
Description=Domain Crawler — monitor (progress, metrics, alerts)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-monitor
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Loopback guard for the metrics address: env beats YAML (see the unit
# header).
Environment=CRAWLER_MONITOR_LISTEN=127.0.0.1:9100
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-monitor
ExecStart=/opt/crawler/bin/monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=128M
# CPU priority (T-158): a supporting service — the monitoring aggregates
# over 47M rows (the BacklogLoop GROUP BY every 30 s + ZoneStats, §12) must
# not take CPU from the pipeline (PSI some 91–95%). Weight 50 vs 1000 for
# the critical path; a slower summary under starvation is the intended
# trade-off.
CPUWeight=50
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
