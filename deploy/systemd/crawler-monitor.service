# Domain Crawler — monitor: прогресс зон, метрики, алерты (ТЗ 5.9).
# MemoryMax — строка бюджета «Go-сервисы ≈ 1,3 ГБ» (ТЗ 3.2), раскладка —
# docs/deploy.md. Адрес HTTP-ендпоинта задаёт monitor.listen в конфиге
# (важнее METRICS_ADDR — docs/services.md); Environment ниже — страховка
# loopback (переменная окружения важнее YAML — docs/configuration.md),
# даже если config.yaml скопирован из примера без правок: метрики не
# выставляются на внешние интерфейсы (ТЗ §9), как у остальных сервисов
# (METRICS_ADDR=127.0.0.1:9101…9108 в их юнитах). /dev/nvme* (SMART,
# ТЗ 10.3) отдаётся группе nvme-smart (udev-правило и drop-in —
# deploy/smartd/, T-089): без него алерт износа честно «не измеряется».
# Доставка алертов в Telegram (T-162) читает TELEGRAM_BOT_TOKEN/
# TELEGRAM_CHAT_ID из EnvironmentFile ниже (monitor звёт exec
# /opt/crawler/bin/telegram-notify.sh — docs/operations.md §4.3); без
# секретов доставка выключена, алерты остаются Warn в journald.

[Unit]
Description=Domain Crawler — monitor (прогресс, метрики, алерты)
PartOf=crawler.target
# Комментарий о After/Wants без Requires — crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-monitor
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Loopback-страховка адреса метрик: env важнее YAML (см. шапку юнита).
Environment=CRAWLER_MONITOR_LISTEN=127.0.0.1:9100
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-monitor
ExecStart=/opt/crawler/bin/monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=128M
# CPU-приоритет (T-158): обвязка — агрегаты мониторинга по 47 млн строк
# (BacklogLoop GROUP BY каждые 30 с + ZoneStats, §12) не должны
# отнимать CPU у конвейера (PSI some 91–95%). Вес 50 против 1000 у
# критического пути; замедление сводки при голоде — размен штатный.
CPUWeight=50
LimitNOFILE=65535
UMask=0007
# --- Изоляция (ТЗ §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
