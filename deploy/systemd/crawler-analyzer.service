# Domain Crawler — analyzer: Laravel discovery by rules (spec 5.8).
# MemoryMax — the "Go services ≈ 1.3 GB" budget line (spec 3.2); breakdown in
# docs/deploy.md. Reads rules from /etc/crawler/rules (RO — ProtectSystem),
# reload without restart: systemctl kill -s HUP crawler-analyzer
# (Options.OnSIGHUP, docs/services.md).

[Unit]
Description=Domain Crawler — analyzer (Laravel discovery)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-analyzer
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9106
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-analyzer
ExecStart=/opt/crawler/bin/analyzer
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=128M
# CPU priority (T-158): background analysis must not take CPU away from
# the check — analyzer held 66% CPU with the pipeline live and PSI some
# 91–95% (§12). Weight 200 + a hard quota of 1.5 cores: it does not cut
# current work (66% < 150%), it limits bursts of background passes over
# the accumulated content.
CPUWeight=200
CPUQuota=150%
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Content store: it reads packs, but also takes the shared flock .packs.lock
# (O_RDWR — protection against rotation during reads, internal/content) — the
# directory must be writable by the crawler group (T-135: without this the
# unit failed with permission denied on opening the lock).
ReadWritePaths=/var/lib/crawler/content
# It reads rules from /etc/crawler/rules (RO under strict) and writes nothing.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
