# Domain Crawler — Chromium recycle timer (T-208): every 2 h it starts
# crawler-chromium-recycle.service (a restart of crawler-chromium; the pair
# was installed on the production server Oct 29 in the T-198 window and
# moved into the set). The period follows the Oct 29 degradation
# measurement (~2 h, the header of crawler-chromium-recycle.service); the
# first run comes 30 min after the timer is activated (OnActiveSec) — right
# after the start the browser is fresh and needs no recycle. Rationale and
# installation — docs/deploy.md §2.2.
#
# Lifecycle — together with the set (T-215): PartOf=crawler.target stops
# the timer when the set is stopped — the next tick (every 2 h) will not
# start the stopped chromium; WantedBy=crawler.target (the enable symlink
# in crawler.target.wants/) brings the timer back when the set starts:
# PartOf only propagates stop/restart, not start.

[Unit]
Description=crawler-chromium recycle timer every 2 h
PartOf=crawler.target

[Timer]
OnActiveSec=30min
OnUnitActiveSec=2h

[Install]
WantedBy=crawler.target
