# Domain Crawler — dashboard: the operator web dashboard of the pipeline
# (dashboard spec, stage 15). A read-only "at a glance" summary behind a
# password (HTTP Basic); creds — dashboard.username/password_hash in
# config.yaml (generation — crawlerctl dashboard-secret, docs/deploy.md
# §4.5). dashboard.listen — the public address: like the landing page, it
# keeps loopback (127.0.0.1:8090), a reverse-proxy with TLS publishes it
# externally — Basic credentials must not travel in plain text (dashboard
# spec §9.1; the web/T-124 scheme, docs/deploy.md §6). The Environment
# below is the loopback guard of the public listener (an environment
# variable beats YAML — docs/configuration.md), even if config.yaml is
# copied from the example unedited; metrics and probes — METRICS_ADDR on
# loopback 127.0.0.1:9108 (like 9101…9107 in the other units): not exposed
# externally (spec §9).
# MemoryMax — the "Go services" budget line (spec 3.2); breakdown —
# docs/deploy.md: the dashboard is a light DB/Redis reader (the SQL engine
# computes the aggregates), 128M, like monitor.
# The DB pool — 2 connections via Environment (the environment beats YAML):
# a ninth service at 5 from the config example does not fit the
# max_connections=50 budget (9 × 5 + crawlerctl 2 + admin ≈ 48 > 47
# available); snapshot assembly is a single sequential loop, the second
# slot is the /healthz ping (the budget — docs/db.md, "Connections"). The
# global CRAWLER_POSTGRES_POOL_SIZE variable in crawler.env would override
# this value too (EnvironmentFile beats the unit's Environment) — if you
# enable it, recount the budget sum.

[Unit]
Description=Domain Crawler — dashboard (operator dashboard of the pipeline)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-dashboard
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Loopback guards of the addresses: env beats YAML (see the unit header).
# The dashboard's public listener and its metrics — both loopback only.
Environment=CRAWLER_DASHBOARD_LISTEN=127.0.0.1:8090
Environment=METRICS_ADDR=127.0.0.1:9108
# The DB pool is smaller than the config example — the max_connections=50
# budget (the header).
# Note: EnvironmentFile (crawler.env) overrides Environment.
Environment=CRAWLER_POSTGRES_POOL_SIZE=2
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-dashboard
ExecStart=/opt/crawler/bin/dashboard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=128M
# CPU priority (T-158): a supporting service — a read-only DB/Redis reader
# (the SQL engine computes the aggregates); under CPU starvation (§12) the
# pipeline matters more, weight 50 vs 1000 for the critical path.
CPUWeight=50
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
