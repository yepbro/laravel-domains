# Domain Crawler — scheduler: domain selection, enqueueing tasks into Redis
# Streams, reclaiming the stuck ones (spec 5.3). MemoryMax — the "Go
# services ≈ 1.3 GB" budget line (spec 3.2); breakdown — docs/deploy.md.

[Unit]
Description=Domain Crawler — scheduler (task enqueueing)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-scheduler
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9102
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-scheduler
ExecStart=/opt/crawler/bin/scheduler
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# Spec 3.2/10.1: an OOM in the cgroup — only this service, PostgreSQL is
# not affected.
MemoryMax=128M
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# It writes no files: all work happens in PostgreSQL/Redis (migrations are
# applied at startup via the DB).
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
