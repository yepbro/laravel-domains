# Domain Crawler — ingest: ingesting domain files from incoming/ (spec 5.1).
# MemoryMax — the "Go services ≈ 1.3 GB" budget line (spec 3.2); the
# per-service breakdown — docs/deploy.md. The user is the static system
# crawler-ingest (why it was chosen over DynamicUser — docs/deploy.md).

[Unit]
Description=Domain Crawler — ingest (domain file ingest)
PartOf=crawler.target
# The ordering after infrastructure is best effort (meta units of OS
# packages); PostgreSQL readiness is not guaranteed — migrations/the pool
# fail with exit code 1 and are restarted by Restart=on-failure (spec 3.4:
# the DB is the source of truth, the worker survives its restart). No
# Requires on purpose: stopping the DB must not stop the workers (the pool
# reconnects on its own).
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-ingest
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9101
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-ingest
ExecStart=/opt/crawler/bin/ingest
Restart=on-failure
RestartSec=5s
# Graceful worker shutdown (spec 3.4): SIGTERM → finishing the task in
# flight; the framework budget is 10 s (service.ShutdownTimeout) plus the
# metrics HTTP server and the DB pool.
TimeoutStopSec=30s
# Spec 3.2/10.1: a cgroup memory cap — the OOM killer will hit only this
# service (and systemd will restart it), PostgreSQL stays untouched.
MemoryMax=128M
# Parity with the dev environment (nofile 65535 in
# deploy/docker/compose.yaml); the fs.file-max/fs.nr_open sysctls — T-088.
# ingest holds almost no file descriptors; the value is uniform across the
# set's services.
LimitNOFILE=65535
# The crawler group writes to the shared directories (content) together;
# 0007 — files 660/directories 770 within the group.
UMask=0007
# --- Isolation (spec §9/§10.1: a dedicated user, least privilege) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# incoming: it writes no reports (ingest_files goes to the DB), but it moves
# files to processed/failed/ inside the watched directory — it needs write
# access.
ReadWritePaths=/var/lib/crawler/incoming
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
