# Domain Crawler — Chromium recycle (render): a scheduled restart of the
# crawler-chromium unit every 2 h, driven by the
# crawler-chromium-recycle.timer timer (T-208; installed on the production
# server Oct 29 in the drain window of T-198, moved into the set). In
# remote mode — the production deploy default — the worker cannot restart
# a foreign browser process (T-065): without recycle the process
# accumulates memory (400→950+ MiB over ~2 h) and degrades — render
# timeouts double; the Oct 29 measurement: after recycle they are twice as
# low, 227→110. The restart interrupts in-flight renders (<1 min) —
# deliveries return via claim (idempotency, spec 3.4), and the worker
# survives the consumption pause with a dead browser (docs/render.md).
# Rationale and installation — docs/deploy.md §2.2.
# PartOf stops the unit together with the set: after stop crawler.target
# an unfinished recycle does not continue (T-215).

[Unit]
Description=Recycle of crawler-chromium (render debt drain T-198)
PartOf=crawler.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart crawler-chromium.service
