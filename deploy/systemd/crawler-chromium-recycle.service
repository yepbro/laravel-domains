# Domain Crawler — ресайкл Chromium (render): плановый рестарт юнита
# crawler-chromium раз в 2 ч, запускается таймером
# crawler-chromium-recycle.timer (T-208; на боевом сервере установлен
# 29.10 в окне дренажа T-198, перенесён в комплект). В remote-режиме —
# по умолчанию боевого деплоя — воркер не может перезапустить чужой
# браузер (T-065): без ресайкла процесс копит память (400→950+ МиБ
# за ~2 ч) и деградирует — таймауты рендера удваиваются; замер 29.10:
# после ресайкла вдвое ниже, 227→110. Рестарт прерывает идущие рендеры
# (<1 мин) — доставки вернутся клеймом (идемпотентность ТЗ 3.4), воркер
# переживает паузу потребления при мёртвом браузере (docs/render.md).
# Обоснование и установка — docs/deploy.md §2.2.

[Unit]
Description=Ресайкл crawler-chromium (дренаж рендер-долга T-198)

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart crawler-chromium.service
