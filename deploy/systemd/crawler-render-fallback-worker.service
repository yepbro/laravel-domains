# Domain Crawler — render-fallback-worker (worker B): finishing on
# Chromium the tasks that failed rendering on the primary engine (render
# spec stage 35 §4.5, T-240; the q:render-fallback queue — T-237). The same
# binary as crawler-render-worker.service: the build differs in the
# consumption stream — RENDER_WORKER_STREAM=q:render-fallback (a run
# parameter, like METRICS_ADDR; the consumption stream is a build-time
# parameter of the worker, not a configuration field, spec §4.1 item 3).
# The group is the stream's canonical pair (queue.WorkingGroups):
# render-fallback-worker, separate from the primary render-worker —
# q:render-fallback deliveries are not shared with the main pipeline.
#
# The rate (FR-13): render.fallback.worker_rate records over a sliding
# 1 min window (renderworker.RateWindow) from the shared
# /etc/crawler/config.yaml — a batch mode of "collect and finish" without
# adding chromium capacity; it also acts while the fallback is off (the
# accumulated backlog is finished down to empty, FR-14). Worker B does not
# publish to the fallback (recursion is forbidden, FR-10 — publishFallback
# filters by the consumption stream).
#
# Chromium: shared with the primary worker — render.remote_url from
# crawler.env (ws://127.0.0.1:9222, the crawler-chromium.service unit; a
# restart from inside the worker is impossible in remote mode — the cap is
# held by the chromium unit's MemoryMax). The engine behind build B is
# pinned by the unit-local EnvironmentFile below (render-fallback-worker.env,
# AFTER the shared crawler.env — it wins): when the primary worker is moved
# to the candidate engine (editing render.engine/remote_url in the shared
# config/environment, T-248/T-249), worker B must stay on chromium — a
# recursive fallback is forbidden (FR-10), and the builds' metrics are not
# mixed (crawler_render_records_total{engine}). The recycle pair of T-208
# (crawler-chromium-recycle.timer) applies AS IS, no new files needed: the
# recycle service's ExecStart restarts exactly crawler-chromium.service —
# the browser shared by both workers; worker B needs no pair of its own
# (there is no local headless-shell in the native deploy — that is the
# docker-runtime mode, the render-fallback service of the runtime profile
# in deploy/docker/compose.yaml, where the worker does the restarts itself,
# T-065).
#
# The metrics port 9120 (S-P2-3): 9101–9108 are taken by the set, 9109+ is
# the render-worker@ instance range (§2.2); the port is placed outside the
# natural instance growth zone (9109, 9110, 9111, …) so that scaling to the
# next free port does not collide with worker B — do not start
# crawler-render-worker@9120 (a bind collision).
# Not in the set's enable list (§4.6): enabling it is a deliberate step of
# introducing the fallback (the §2 budget line +256M, +5 DB pool
# connections — §4.5); until the canary is ready it may run on an empty
# queue — the wiring check (spec §4.5 item 3).

[Unit]
Description=Domain Crawler — render-fallback-worker (worker B: fallback finishing on Chromium)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target crawler-chromium.service postgresql.service redis-server.service unbound.service
Wants=network-online.target crawler-chromium.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# A separate user per the "one per service" rule (spec §10.1, §3): worker B
# is a different logical service (its own stream/group), not an instance of
# the render-worker@ template (those share the primary worker's user —
# scaling a single service).
User=crawler-render-fallback-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Pinning chromium to build B (spec §4.5 item 1): the unit-local file is
# read AFTER the shared crawler.env — same-named variables win (the
# priority of later EnvironmentFiles, like the per-instance file of
# crawler-render-worker@.service). Contents (installation — docs/deploy.md
# §2.3):
#   CRAWLER_RENDER_ENGINE=chromium
#   CRAWLER_RENDER_REMOTE_URL=ws://127.0.0.1:9222   # only when the shared
#   # crawler.env has been moved to the candidate engine or a second
#   # Chromium (:9223) — it returns B to the primary unit's chromium.
# The "-": before the fallback is enabled the unit starts even without the
# file (the engine is then inherited from the shared config — the base
# behavior without the canary).
EnvironmentFile=-/etc/crawler/render-fallback-worker.env
Environment=METRICS_ADDR=127.0.0.1:9120
# Worker B build (FR-12): the consumption stream q:render-fallback; the
# group is derived as the stream's canonical pair (render-fallback-worker).
Environment=RENDER_WORKER_STREAM=q:render-fallback
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-render-fallback-worker
ExecStart=/opt/crawler/bin/render-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=256M
# Same as the primary render-worker (the T-092 §6 measurement, T-169): DOM
# in flight ≤ render.contexts × content.max_store_bytes + pgx/queue
# buffers; worker B's rate is lower, the cap is left with headroom — the
# post-deploy check: memory.events oom=0, NRestarts 0 (the budget —
# docs/deploy.md §2/§2.3).
# CPU priority (T-158): a pipeline stage with a rate cap — weight 300, like
# the primary worker; the render's heavy CPU lives in chromium (a separate
# cgroup at the default 100).
CPUWeight=300
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# It replaces HTML with DOM in the content store shared with http-worker.
ReadWritePaths=/var/lib/crawler/content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
