# Domain Crawler — http-worker: HTTP-загрузка, редиректы, алиасы (ТЗ 5.5).
# Самый тяжёлый из Go-сервисов (раскладка бюджета — docs/deploy.md):
# до http.task_concurrency доменных задач на экземпляр (256 по умолчанию,
# T-139; скользящее потребление q:http — потолок по замерам T-092) × тела
# до 2 МиБ, удерживаемые до конца задачи домена (дедупликация алиасов),
# кэш итоговых URL и хранилище контента. MemoryMax — строка «Go-сервисы
# ≈ 1,3 ГБ» (ТЗ 3.2); адекватность 384M новому параллелизму подтверждается
# повторным замером комплектом T-092 после деплоя (docs/load-measurements.md).

[Unit]
Description=Domain Crawler — http-worker (HTTP-загрузка)
PartOf=crawler.target
# Комментарий о After/Wants без Requires — crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-http-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9104
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-http-worker
ExecStart=/opt/crawler/bin/http-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=384M
# http.concurrency 2000 — по соединению на проверку; nofile как в
# dev-окружении, sysctl (ip_local_port_range, conntrack) — T-088.
LimitNOFILE=65535
UMask=0007
# --- Изоляция (ТЗ §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Пак-файлы контента пишет в общий с render-worker каталог (группа crawler,
# setgid-каталог — права новых файлов остаются в группе).
ReadWritePaths=/var/lib/crawler/content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
