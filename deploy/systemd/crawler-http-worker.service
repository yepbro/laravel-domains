# Domain Crawler — http-worker: HTTP-загрузка, редиректы, алиасы (ТЗ 5.5).
# Самый тяжёлый из Go-сервисов (раскладка бюджета — docs/deploy.md):
# до http.task_concurrency доменных задач на экземпляр (192 по умолчанию —
# T-157, временно до T-163; T-139 — скользящее потребление q:http) × тела
# до 2 МиБ, удерживаемые до конца задачи домена (дедупликация алиасов),
# кэш итоговых URL и хранилище контента. MemoryMax 900M — по повторному
# замеру после T-139 (docs/load-measurements.md §11, T-143): 256 слотов
# держали anon avg ≈ 855 MiB (834–873, oom=0 в окне 12 мин), т.е.
# ≈ 3.34 MiB на слот (типичная смесь: тела записей-оригиналов, каждое
# ≤ 2 МиБ, + буферы; на шаге 128 — ≈ 3.0 MiB/слот); сутки на 256 —
# два фатала юнита (§12, T-157: 05:48 killed by OOM killer, 09:17 пик
# 900.5 MiB = MemoryMax; MemoryHigh 850M — 120 095 reclaim-событий) —
# дефолт понижен до 192, устойчиво по пропитке этапа 22 (860–893 MiB,
# oom=0, NRestarts=0); возврат 256 — после T-163 (стриминг тел) по
# замеру. На сервере потолок задан персистентным drop-in'ом
# `systemctl set-property` — здесь закреплён (drop-in снять:
# load-measurements.md §3). Прежние 384M подходили впритык уже на
# 128 слотах (anon ≈ 380 из 384 MiB, oom=0). Строка «Go-сервисы
# ≈ 1,3 ГБ» (ТЗ 3.2) выдерживается: все Go-сервисы суммарно
# ≈ 1.0–1.15 GiB (docs/deploy.md §2).

[Unit]
Description=Domain Crawler — http-worker (HTTP-загрузка)
PartOf=crawler.target
# Комментарий о After/Wants без Requires — crawler-ingest.service.
After=network-online.target postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-http-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
Environment=METRICS_ADDR=127.0.0.1:9104
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-http-worker
ExecStart=/opt/crawler/bin/http-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# Мягкий потолок (T-145): выше 850M ядро возвращает память reclaim'ом
# (троттлинг аллокаций), не дожидаясь hard-лимита 900M и OOM-kill.
# Замер сэмплером — MemoryCurrent cgroup (anon + page cache): 192 слота
# стабильно 860–893 MiB (пропитка волны 21, oom=0). Слотовая
# составляющая ≈3.34 MiB/слот (замер §11 тем же сэмплером) ≈ 640 MiB —
# остальное page cache пишущего контент-стора: reclaim под MemoryHigh
# режет в первую очередь его (безболезненно), а не живые слоты. Рост
# выше 850 сверх кеша — перегрев (стартовый пик: раскатка на 256 давила
# healthz, §11 — 834–873 MiB): троттлинг даёт GC/scavenger время
# вернуть память за 50 MiB до OOM-kill слотов. Рост memory.events `high`
# в рабочей зоне — норма; `oom`/`oom_kill` и NRestarts — нет: их видит
# алерт unit_oom (internal/monitor/unitevents.go, T-145).
MemoryHigh=850M
MemoryMax=900M
# http.concurrency 2000 — по соединению на проверку; nofile как в
# dev-окружении, sysctl (ip_local_port_range, conntrack) — T-088.
LimitNOFILE=65535
UMask=0007
# --- Изоляция (ТЗ §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Пак-файлы контента пишет в общий с render-worker каталог (группа crawler,
# setgid-каталог — права новых файлов остаются в группе).
ReadWritePaths=/var/lib/crawler/content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
