# Domain Crawler — the group target of all application services (spec 4.1).
# The services are bound to this target with PartOf=: `systemctl stop
# crawler.target` stops the whole set at once (in the graceful order of the
# units), restart restarts them. The chromium recycle pair (T-215): the
# timer joins the target with an enable symlink (WantedBy=crawler.target),
# the service is brought up by the timer; both units are PartOf= (not in
# the Wants list above).
# Infrastructure (postgresql/redis/unbound — OS packages, see the drop-ins
# alongside) is not part of the target: it has the package's own lifecycle.
# Installation and enabling — docs/deploy.md (spec 10.1).

[Unit]
Description=Domain Crawler — all application services
Wants=crawler-chromium.service
Wants=crawler-ingest.service
Wants=crawler-scheduler.service
Wants=crawler-dns-worker.service
Wants=crawler-http-worker.service
Wants=crawler-render-worker.service
Wants=crawler-analyzer.service
Wants=crawler-monitor.service
Wants=crawler-web.service
Wants=crawler-dashboard.service
After=network-online.target

[Install]
WantedBy=multi-user.target
