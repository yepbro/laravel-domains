# Domain Crawler — Chromium headless-shell for the render-worker (CDP on
# 127.0.0.1:9223). Spec 3.2: a separate budget line — "Chromium (render,
# cgroup MemoryMax) ≈ 2 GB"; spec 10.1: Chromium is a separate
# package/directory (not an OS package but the headless-shell distribution
# in /opt/crawler/chromium — the same build as in the chromedp/headless-shell
# image of the dev/dev-runtime environment; the version —
# CHROMEDP_HEADLESS_IMAGE in .env.example).
#
# A separate unit, not a worker process (empty render.remote_url = own
# process): Chromium gets its own cgroup with a 2 GB cap — an OOM inside
# the browser (a separate tab/render process) is killed by the kernel
# within that cgroup and restarted by systemd, without touching the worker
# and the other services; per-page restarts from inside the worker (T-065)
# do not work in remote mode (a foreign process) — the cap and the restart
# are owned by this unit (an analogy of the mem_limit of the dev chromium
# service, docs/render.md, docs/deploy.md).
#
# --no-sandbox is mandatory: an unprivileged user without a user-namespace
# sandbox (the worker passes the same flag in local mode, internal/render).
# Listens on loopback only — CDP is not exposed (spec §9).
#
# The second chromium instance is a template for the future (T-209), NOT
# enabled by default: it comes up when the first browser saturates
# (MemoryCurrent of the chromium unit near 2048M / a steady-state speed cap
# with free worker slots) and memory is available — its own cgroup ≈2 GB, a
# separate budget line of spec 3.2. It was born in the Oct 29 experiment
# (the drain window of T-198) as a sed copy of crawler-chromium.service:
# port 9222→9223, --user-data-dir=…/chromium2/profile, Description; the
# rest — as for the first instance, except ReadWritePaths (the fix —
# below). The name is a concrete unit, not an @.service template: systemd
# has long expanded specifiers in isolation paths (ReadWritePaths=) (since
# v233; version 255 works on the server), but the pair "port 9223 +
# chromium2 profile" cannot be derived from a single %i (9223 and 2 are
# different numbers) — a template would require renaming the port or the
# directory on the server; a concrete unit keeps the server directives
# literally and is compared byte-by-byte (md5, the T-208 precedent).
#
# The defect of the copied unit (Oct 29, recorded so it is not repeated):
# ReadWritePaths must point to the profile directory of THIS instance —
# chromium2, and it is a replacement, not an addition (the first instance's
# directory is not needed by the second). The sed copy kept the original
# line "ReadWritePaths=/var/lib/crawler/chromium": combined with
# ProtectSystem=strict it forbids writing to chromium2 → headless-shell
# cannot create the profile → exit → restart loop → start-limit
# (StartLimitBurst=10 within 5 min) → unit failed; meanwhile the worker on
# ws://127.0.0.1:9223 crash-loops with "dial tcp 127.0.0.1:9223:
# connection refused". The profile directory is created before the start:
# install -d -o crawler-chromium -g crawler -m 0770 /var/lib/crawler/chromium2.
#
# The outcome of the Oct 29 experiment: on 4 vCPU the second browser did
# not speed up the pipeline (96 domains/min vs 112–144 for one) — the CPU
# is the narrow spot, two browsers total ≈400%; the unit is disabled on the
# server, the worker env file was removed, the file is kept as a template
# for returning to two browsers on extended hardware. The recycle timer
# crawler-chromium-recycle.timer (T-208) does not cover the second instance
# (the unit name is hardcoded in the recycle service's ExecStart=) — it
# needs its own timer modeled on it. Installation and rollback —
# docs/deploy.md §2.2 (the §4.6 set copies by the crawler*.service mask and
# is not in the enable --now list).

[Unit]
Description=Domain Crawler — Chromium second instance (headless-shell, CDP 127.0.0.1:9223, deploy.md §2.2)
PartOf=crawler.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-chromium
Group=crawler
SyslogIdentifier=crawler-chromium
ExecStart=/opt/crawler/chromium/headless-shell --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --no-sandbox --disable-gpu --user-data-dir=/var/lib/crawler/chromium2/profile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
# Spec 3.2: the Chromium budget is ≈ 2 GB (a cap above the budget is not
# needed: the worker is in a separate cgroup, this caps only the browser;
# comparable to MEM_CHROMIUM/MEM_RENDER of the dev environment).
MemoryMax=2048M
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
# The set is softer than for the Go services: V8 requires executable memory
# for the JIT (MemoryDenyWriteExecute would break JS), and the browser's
# network change listener talks over AF_NETLINK. The rest — as for the
# services.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The browser's service profile (task pages live in isolated CDP contexts
# and never touch it — docs/render.md). The directory is this instance's
# only (chromium2): when copying the unit manually, replacing it is
# mandatory — a foreign directory means a start into start-limit (the
# defect — header, T-209).
ReadWritePaths=/var/lib/crawler/chromium2
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
