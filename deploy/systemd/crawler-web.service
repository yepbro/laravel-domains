# Domain Crawler — web: the public landing page (stage 13, T-121…T-124).
# web.listen — the public port of the visitor-facing system: a reverse-proxy
# with TLS publishes the service externally (the first example —
# deploy/nginx/), the service itself keeps loopback (the config default
# 127.0.0.1:8080). Metrics and probes — METRICS_ADDR on loopback
# (127.0.0.1:9107, like the other units): nothing but the landing page is
# exposed externally (spec §9); the operator dashboard is a separate unit,
# crawler-dashboard, with its own listener.
# MemoryMax — the "Go services" budget line (spec 3.2); breakdown —
# docs/deploy.md: live form checks drive the full checker pipeline
# (T-123: DNS → HTTP with page bodies → render → analysis), hence 256M,
# not the 128M of the "light" units without network buffers. Since T-220
# the pipeline runs on a single long-lived circuit (a resolver chain with a
# small UDP pool ≈ 48 fd per service, a shared Fetcher, one render.Manager),
# concurrency is cut by web.live_concurrency (overload — a quick 503, not a
# queue up to web.timeout): parallel checks no longer multiply sockets per
# request and no longer exhaust LimitNOFILE together with
# /healthz.
# A unix socket instead of TCP (depends on the deployment site):
# CRAWLER_WEB_LISTEN=
# /run/crawler-web/web.sock in crawler.env + proxy_pass
# http://unix:/run/crawler-web/web.sock in nginx — the RuntimeDirectory
# below creates the directory in /run (ProtectSystem=strict forbids the
# rest).

[Unit]
Description=Domain Crawler — web (public landing page)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
# crawler-chromium — ordering only: a live form check needs CDP
# (render.remote_url); without the browser the landing page and stored data
# work.
After=network-online.target crawler-chromium.service postgresql.service redis-server.service unbound.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-web
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Loopback guard for the metrics address: env beats YAML (see the unit
# header).
Environment=METRICS_ADDR=127.0.0.1:9107
# The public address is not pinned: web.listen from the config (loopback
# behind nginx); to change it — CRAWLER_WEB_LISTEN in crawler.env (TCP or a
# unix socket).
RuntimeDirectory=crawler-web
WorkingDirectory=/var/lib/crawler
SyslogIdentifier=crawler-web
ExecStart=/opt/crawler/bin/web
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=256M
# CPU priority (T-158): a supporting service — the landing page and one-off
# live form checks are no match for the mass pipeline under CPU starvation
# (§12: PSI some 91–95%); weight 50 vs 1000 for the critical path.
CPUWeight=50
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
