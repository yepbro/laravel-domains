# Domain Crawler — render-worker, the second and further instances
# (a unit template, step 3 of T-169; the first instance is the single unit
# crawler-render-worker.service, metrics 9105). The same binary and the
# same q:render consumer group: consumer groups scale workers horizontally
# (spec 4.2), the consumer name is per-process (render-worker-<pid>,
# internal/renderworker.Options), the instances conflict neither in
# XREADGROUP (deliveries are split between the group's consumers) nor in
# XAUTOCLAIM claims (a live worker acknowledges earlier than
# redis.claim_min_idle); the content store is shared by the writing units
# (http-worker, render-worker — coordination via the DB, spec 5.7).
# It is justified when contexts 8 (step 1) and timeout per the histogram
# (step 2) do not drain q:render: the lag does not shrink at ≥1.5k/h while
# PSI CPU some < 95% — the step order and the check — docs/deploy.md §2.2.
#
# The instance name = the metrics port: crawler-render-worker@9109.service
# listens on METRICS_ADDR 127.0.0.1:9109 (9101–9108 are taken by the set;
# 9109+ are free except 9120 — the fixed port of the permanent worker B
# unit crawler-render-fallback-worker, placed outside the instance growth
# zone, §2.3 of deploy.md; metrics — loopback only, spec §9).
# METRICS_ADDR must not be set in the shared /etc/crawler/crawler.env —
# the EnvironmentFile overrides the unit's Environment and would collide
# the instances' ports.
#
# Its own cgroup: the 256M cap and CPUWeight 300 — separate from the first
# instance (the budget line adds to the §2 sum of deploy.md).
#
# Chromium: by default shared with the first worker (render.remote_url from
# crawler.env → ws://127.0.0.1:9222) — the CDP browser holds many
# consumers, the chromium unit's memory budget is one for all. On
# saturation of one Chromium (RSS near the render.restart_memory_bytes
# threshold / the unit's MemoryCurrent near 2048M, the steady-state speed
# cap) — a second chromium instance on :9223: the per-instance file
# /etc/crawler/render-worker@<port>.env (optional, later than the shared
# crawler.env — it overrides) with
# CRAWLER_RENDER_REMOTE_URL=ws://127.0.0.1:9223; the second chromium unit
# is in the set: crawler-chromium2.service (deploy.md §2.2, T-209;
# ReadWritePaths must point to the chromium2 directory — the sed-copy
# defect is described in the unit header), its own cgroup ≈2 GB (spec 3.2 —
# a separate budget line; on an 8 GB server — only per a measurement of
# free memory, MemAvailable §12 of load-measurements.md).
# Instance logs: journalctl -t crawler-render-worker@<port>.

[Unit]
Description=Domain Crawler — render-worker, instance @%i (metrics port)
PartOf=crawler.target
# For the After/Wants without Requires rationale, see crawler-ingest.service.
After=network-online.target crawler-chromium.service postgresql.service redis-server.service unbound.service
Wants=network-online.target crawler-chromium.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=crawler-render-worker
Group=crawler
EnvironmentFile=/etc/crawler/crawler.env
# Per-instance overrides (later than the shared crawler.env — they win):
# CRAWLER_RENDER_REMOTE_URL=ws://127.0.0.1:9223 with a second Chromium.
EnvironmentFile=-/etc/crawler/render-worker@%i.env
# The metrics port is the template parameter: the instance name = the port
# (9109+, except 9120; 9101–9108 are taken by the set, 9120 — the fixed
# port of the permanent fallback worker B unit, §2.3 of deploy.md; the
# unit header covers the conflict with crawler.env).
Environment=METRICS_ADDR=127.0.0.1:%i
WorkingDirectory=/var/lib/crawler
ExecStart=/opt/crawler/bin/render-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=256M
# CPU priority (T-158): like the first instance — a pipeline stage, not
# the narrow spot; the render's heavy CPU lives in chromium (a separate
# cgroup at the default 100, the §12 measurement: chromium 140%): the
# worker sets the priority of the pair.
CPUWeight=300
LimitNOFILE=65535
UMask=0007
# --- Isolation (spec §9/§10.1) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# It replaces HTML with DOM in the content store shared with http-worker.
ReadWritePaths=/var/lib/crawler/content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=crawler.target
