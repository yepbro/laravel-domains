# Ежедневная выгрузка списка новых доменов (NRD) smet.cz в incoming/
# ingest — deploy/nrd/README.md, docs/deploy.md §4.9.
#
# Время: 05:33 UTC. Ниже — часы МЕСТНОГО времени сервера: cron не умеет
# per-file TZ, зона сервера Europe/Moscow (UTC+3) => 08:33. При смене
# зоны сервера (timedatectl) пересчитайте часы строки обратно в 05:33 UTC.
#
# Почему 05:33 UTC, а не вечером (перенос 26.10, T-205): применение
# суточного NRD-файла (~470 тыс. доменов) попало в вечернее окно CPU-
# голода (PSI ~80%) и полуночный шторм суточной перепроверки — теперь
# загрузка идёт вне часов голода; день источника закрыт >9 ч, контракт
# «только закрытые дни» сохранён (README).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
33 8 * * * root /usr/local/bin/crawler-fetch-nrd
