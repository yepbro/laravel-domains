# Local environment and secrets
.env

# Environment working data
/var/
/tmp/

# Go build artifacts
/bin/

# Generated Tailwind landing artifact (make web-css / css stage of Dockerfile.go):
# embedded into the binary via go:embed, not stored in git
internal/web/static/app.css
*.test
*.out
coverage.*
# ...except the testbedgen generated artifacts: CoreDNS DNS zones (db.<zone>.test)
# and Caddy fixtures for the *.test zones are committed to the repo — the testbed
# is not regenerated in CI, and without the zones unbound/coredns fail healthchecks.
!deploy/docker/testbed/coredns/zones/*
!deploy/docker/testbed/web/sites/*.test/
!deploy/docker/testbed/web/sites/*.test/**

# IDE
.idea/
.vscode/
*.swp
.config/

# Production binary builds (deploy.md §4.2)
out/

# open-codebase-index
.opencode/index/

# codegraphcontext (local MCP index)
.codegraphcontext/
